# Redmi 8 phone UI (extras/phone-ui): notch-aware top bar, windows open
# maximized, dark Yaru, a small dock. System defaults; every user can still
# change them.
[org/gnome/shell]
enabled-extensions=['olive-display@redmi8', 'ubuntu-dock@ubuntu.com']
favorite-apps=['firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Settings.desktop']

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Yaru-dark'
icon-theme='Yaru-dark'

[org/gnome/mutter]
edge-tiling=false

[org/gnome/desktop/wm/keybindings]
maximize=@as []
unmaximize=@as []

[org/gnome/mutter/keybindings]
toggle-tiled-left=@as []
toggle-tiled-right=@as []

[org/gnome/shell/extensions/dash-to-dock]
dash-max-icon-size=44
show-mounts=false

[org/gnome/nautilus/preferences]
default-folder-viewer='icon-view'
