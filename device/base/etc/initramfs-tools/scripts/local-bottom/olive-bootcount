#!/bin/sh
# Redmi 8: boot counter. Every boot counts up; olive-autoconfirm.timer resets
# the counter 90 s into a healthy boot. After three boots that never got
# there, the boot stops here with the USB rescue shell up:
#   telnet 169.254.66.1        then   touch /tmp/go   to continue anyway
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

state=${rootmnt}/var/lib/olive
mkdir -p "$state" 2>/dev/null
count=$(cat "$state/bootcount" 2>/dev/null)
case "$count" in ''|*[!0-9]*) count=0 ;; esac
count=$((count + 1))
echo "$count" > "$state/bootcount" 2>/dev/null
sync
if [ "$count" -ge 3 ]; then
	echo "OLIVE: $count boots without confirmation; waiting in the USB rescue shell" > /dev/kmsg
	while [ ! -e /tmp/go ]; do sleep 1; done
fi
/bin/busybox-full killall telnetd 2>/dev/null
exit 0
